#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys


args = sys.argv[1:]
log = Path(os.environ["MAO_FAKE_LOG"])
with log.open("a", encoding="utf-8") as stream:
    stream.write(
        json.dumps(
            {
                "executable": Path(sys.argv[0]).name,
                "args": args,
                "cwd": str(Path.cwd()),
            }
        )
        + "\n"
    )

if "--version" in args:
    print("1.1.fake")
elif "--help" in args:
    print("--quality Rendering quality (ultra)", file=sys.stderr)
    print("--effort Reasoning effort (low|medium|high)", file=sys.stderr)
elif args and args[0] == "models":
    fixture = Path(os.environ["MAO_FAKE_FIXTURES"]) / "agy-models.txt"
    print(fixture.read_text(encoding="utf-8"), end="")
elif "unavailable-model" in args:
    print("model unavailable", file=sys.stderr)
    raise SystemExit(1)
elif "Reply with exact text OK." in args:
    requested = args[args.index("--model") + 1]
    print(json.dumps({"type": "result", "result": "OK", "model": requested}))
else:
    fixture = Path(os.environ["MAO_FAKE_FIXTURES"]) / "review-valid.json"
    print(
        json.dumps(
            {"type": "result", "result": fixture.read_text(encoding="utf-8")}
        )
    )
